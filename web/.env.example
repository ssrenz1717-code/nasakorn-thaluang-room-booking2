# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ไฟล์ .env จะไม่ขึ้น git)
#
# URL ของ Apps Script Web App ที่ deploy แล้ว (ลงท้ายด้วย /exec)
VITE_API_URL=https://script.google.com/macros/s/xxxxxxxx/exec
#
# OAuth Client ID ตัวเดียวกับที่ใส่ใน Script Properties ของ Apps Script
VITE_GOOGLE_CLIENT_ID=123456789-xxxxxxxx.apps.googleusercontent.com
